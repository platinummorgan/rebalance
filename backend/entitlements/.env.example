PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Optional request guard. If set, clients must send X-Entitlement-Api-Key header.
ENTITLEMENT_API_KEY=replace_me

# Google Play package name for your app.
GOOGLE_PLAY_PACKAGE_NAME=com.wealthdial.app

# Comma-separated list of one-time/lifetime SKU ids.
GOOGLE_PLAY_LIFETIME_PRODUCT_IDS=founder_lifetime

# Set true only if you intentionally want to allow purchase token reassignment.
ALLOW_TOKEN_TRANSFER=false

# Location of the local metadata DB.
ENTITLEMENT_DB_PATH=./data/entitlements.json
